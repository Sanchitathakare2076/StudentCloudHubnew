<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <stroke
                android:width="2dp"
                android:color="#6335E8"/>
            <corners android:radius="14dp"/>
            <padding
                android:left="8dp"
                android:right="8dp"
                android:top="0dp"
                android:bottom="0dp"/>
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <stroke
                android:width="1dp"
                android:color="#D9D7EF"/>
            <corners android:radius="14dp"/>
            <padding
                android:left="8dp"
                android:right="8dp"
                android:top="0dp"
                android:bottom="0dp"/>
        </shape>
    </item>

</selector>