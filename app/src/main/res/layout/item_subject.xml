<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/subject_card"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <!-- Subject Icon -->
    <TextView
        android:id="@+id/subjectIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="📚"
        android:textSize="22sp"
        android:background="#E5F6FF"/>

    <!-- Subject Information -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="13dp">

        <TextView
            android:id="@+id/subjectName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mathematics"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#25256D"/>

        <TextView
            android:id="@+id/pdfCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="5 PDF files"
            android:textSize="12sp"
            android:textColor="#8888A8"
            android:layout_marginTop="3dp"/>

        <!-- Progress -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:max="100"
            android:progress="50"
            android:layout_marginTop="7dp"/>

    </LinearLayout>

    <!-- Percentage -->
    <TextView
        android:id="@+id/progressText"
        android:layout_width="45dp"
        android:layout_height="wrap_content"
        android:text="50%"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#6335E8"
        android:gravity="center"/>

    <!-- Arrow -->
    <TextView
        android:layout_width="25dp"
        android:layout_height="wrap_content"
        android:text="›"
        android:textSize="27sp"
        android:textColor="#7777A0"
        android:gravity="center"/>

</LinearLayout>