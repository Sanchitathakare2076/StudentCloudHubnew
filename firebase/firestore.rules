rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /users/{uid} { allow read,write: if request.auth != null && request.auth.uid == uid; }
  match /subjects/{id} { allow read,create,update,delete: if request.auth != null && ((resource.data.userId == request.auth.uid) || (request.resource.data.userId == request.auth.uid)); }
  match /notes/{id} { allow read,create,update,delete: if request.auth != null && ((resource.data.userId == request.auth.uid) || (request.resource.data.userId == request.auth.uid)); }
  match /assignments/{id} { allow read,create,update,delete: if request.auth != null && ((resource.data.userId == request.auth.uid) || (request.resource.data.userId == request.auth.uid)); }
 }
}