rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /profile_images/{uid}/{allPaths=**} { allow read, write: if request.auth != null && request.auth.uid == uid; }
    match /note_attachments/{uid}/{allPaths=**} { allow read, write: if request.auth != null && request.auth.uid == uid; }
    match /users/{uid}/{allPaths=**} { allow read, write: if request.auth != null && request.auth.uid == uid; }
  }
}
